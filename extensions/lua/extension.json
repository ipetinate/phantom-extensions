{
  "schemaVersion": 1,
  "id": "ipetinate.lua",
  "name": "Lua",
  "version": "1.0.7",
  "publisher": "Isac Petinate",
  "description": "Lua: highlighting, lua-language-server and StyLua.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/lua",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.c"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "lua",
        "name": "Lua",
        "extensions": [
          "lua"
        ],
        "fileNames": [
          ".luacheckrc"
        ],
        "category": "script",
        "icon": "icons/lua.png",
        "lineComment": "--",
        "blockComment": {
          "open": "--[[",
          "close": "]]"
        },
        "server": {
          "command": "lua-language-server",
          "installHint": "brew install lua-language-server",
          "documentationURL": "https://luals.github.io/",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install lua-language-server",
                "uninstall": "brew uninstall lua-language-server"
              }
            ],
            "documentationURL": "https://luals.github.io/wiki/"
          }
        }
      }
    ],
    "formatters": [
      {
        "id": "stylua",
        "name": "StyLua",
        "command": "stylua",
        "args": [
          "--stdin-filepath",
          "$FILE",
          "-"
        ],
        "extensions": [
          "lua"
        ],
        "installHint": "brew install stylua",
        "documentationURL": "https://github.com/JohnnyMorganz/StyLua",
        "install": {
          "commands": [
            {
              "manager": "brew",
              "command": "brew install stylua",
              "uninstall": "brew uninstall stylua"
            }
          ],
          "documentationURL": "https://github.com/JohnnyMorganz/StyLua"
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.lua",
        "path": "syntaxes/lua.tmLanguage.json",
        "languageId": "lua",
        "license": "TextMate Bundle License",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/lua/syntaxes/lua.tmLanguage.json"
      }
    ]
  }
}
