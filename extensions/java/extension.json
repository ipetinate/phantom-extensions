{
  "schemaVersion": 1,
  "id": "phantom.java",
  "name": "Java",
  "version": "1.0.7",
  "publisher": "Isac Petinate",
  "description": "Java: highlighting and the Eclipse JDT Language Server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/java",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "java",
        "name": "Java",
        "extensions": [
          "java"
        ],
        "category": "compiled",
        "icon": "icons/java.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "jdtls",
          "args": [
            "-data",
            "${HOME}/.cache/jdtls-workspace"
          ],
          "installHint": "brew install jdtls",
          "documentationURL": "https://github.com/eclipse-jdtls/eclipse.jdt.ls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install jdtls",
                "uninstall": "brew uninstall jdtls"
              }
            ],
            "documentationURL": "https://github.com/eclipse-jdtls/eclipse.jdt.ls#installation"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.java",
        "path": "syntaxes/java.tmLanguage.json",
        "languageId": "java",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/java/syntaxes/java.tmLanguage.json"
      }
    ]
  }
}
