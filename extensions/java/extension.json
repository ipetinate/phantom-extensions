{
  "schemaVersion": 1,
  "id": "phantom.java",
  "name": "Java",
  "version": "1.0.0",
  "publisher": "Phantom",
  "description": "Java: highlighting and the Eclipse JDT Language Server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/java",
  "phantom": "0.16.0",
  "contributes": {
    "languages": [
      {
        "languageId": "java",
        "name": "Java",
        "extensions": [
          "java"
        ],
        "category": "compiled",
        "icon": "icons/java.svg",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "keywords": [
          "abstract",
          "assert",
          "boolean",
          "break",
          "byte",
          "case",
          "catch",
          "char",
          "class",
          "const",
          "continue",
          "default",
          "do",
          "double",
          "else",
          "enum",
          "extends",
          "false",
          "final",
          "finally",
          "float",
          "for",
          "goto",
          "if",
          "implements",
          "import",
          "instanceof",
          "int",
          "interface",
          "long",
          "native",
          "new",
          "null",
          "package",
          "permits",
          "private",
          "protected",
          "public",
          "record",
          "return",
          "sealed",
          "short",
          "static",
          "strictfp",
          "super",
          "switch",
          "synchronized",
          "this",
          "throw",
          "throws",
          "transient",
          "true",
          "try",
          "var",
          "void",
          "volatile",
          "while",
          "yield"
        ],
        "syntax": {
          "string": "\"\"\"[\\s\\S]*?\"\"\"|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
          "number": "preset:number",
          "type": "preset:capitalizedType",
          "function": "preset:callBeforeParenOrGeneric",
          "attribute": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        "server": {
          "command": "jdtls",
          "installHint": "brew install jdtls",
          "documentationURL": "https://github.com/eclipse-jdtls/eclipse.jdt.ls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install jdtls",
                "uninstall": "brew uninstall jdtls"
              }
            ],
            "documentationURL": "https://github.com/eclipse-jdtls/eclipse.jdt.ls#installation"
          }
        }
      }
    ]
  }
}
