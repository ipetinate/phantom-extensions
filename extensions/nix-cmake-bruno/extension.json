{
  "schemaVersion": 1,
  "id": "ipetinate.nix-cmake-bruno",
  "name": "Nix, CMake and Bruno",
  "version": "1.0.0",
  "publisher": "Isac Petinate",
  "description": "Three unrelated build and tooling file types in one extension: Nix, CMake and Bruno requests.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/nix-cmake-bruno",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.json",
    "phantom.markdown",
    "phantom.typescript",
    "phantom.xml"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "nix",
        "name": "Nix",
        "extensions": [
          "nix"
        ],
        "category": "infrastructure",
        "icon": "icons/nix.png",
        "lineComment": "#",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        }
      },
      {
        "languageId": "cmake",
        "name": "CMake",
        "extensions": [
          "cmake"
        ],
        "fileNames": [
          "CMakeLists.txt"
        ],
        "category": "infrastructure",
        "icon": "icons/cmake.png",
        "lineComment": "#",
        "blockComment": {
          "open": "#[[",
          "close": "]]"
        }
      },
      {
        "languageId": "bru",
        "name": "Bruno",
        "extensions": [
          "bru"
        ],
        "category": "data",
        "icon": "icons/bruno.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.nix",
        "path": "syntaxes/nix.tmLanguage.json",
        "languageId": "nix",
        "license": "MIT",
        "grammarSource": "https://github.com/nix-community/vscode-nix-ide/blob/effbf3494a43250a537834805b305793994b9ca8/dist/nix.tmLanguage.json"
      },
      {
        "scopeName": "source.cmake",
        "path": "syntaxes/cmake.tmLanguage.json",
        "languageId": "cmake",
        "license": "MIT",
        "grammarSource": "https://github.com/twxs/vs.language.cmake/blob/19b1b8fe2d68d72cf294d0c3c22f0a3fc54f8f6f/syntaxes/CMake.tmLanguage"
      },
      {
        "scopeName": "source.bru",
        "path": "syntaxes/bruno.tmLanguage.json",
        "languageId": "bru",
        "license": "MIT",
        "grammarSource": "https://github.com/usebruno/bruno-vscode/blob/3fdd3547a384cfe8056e3aa4c61569a5963aac9e/syntaxes/bruno.tmLanguage.json",
        "embeddedLanguages": {
          "source.json": "json",
          "text.html.markdown": "markdown",
          "text.xml": "xml",
          "source.js": "javascript"
        }
      }
    ]
  }
}
