{
  "schemaVersion": 1,
  "id": "ipetinate.plantuml-jinja",
  "name": "PlantUML and Jinja2",
  "version": "1.0.0",
  "publisher": "Isac Petinate",
  "description": "Two unrelated small languages in one extension: PlantUML diagrams and Jinja2 templates.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/plantuml-jinja",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "plantuml",
        "name": "PlantUML",
        "extensions": [
          "puml",
          "plantuml",
          "pu",
          "iuml",
          "wsd"
        ],
        "category": "markup",
        "icon": "icons/plantuml.png",
        "lineComment": "'",
        "blockComment": {
          "open": "/'",
          "close": "'/"
        }
      },
      {
        "languageId": "jinja",
        "name": "Jinja2",
        "extensions": [
          "j2",
          "jinja",
          "jinja2"
        ],
        "category": "markup",
        "icon": "icons/jinja.png",
        "blockComment": {
          "open": "{#",
          "close": "#}"
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.wsd",
        "path": "syntaxes/plantuml.tmLanguage.json",
        "languageId": "plantuml",
        "license": "MIT",
        "grammarSource": "https://github.com/qjebbs/vscode-plantuml/blob/5f122113a73bed8f84768d47dc749b4d502f0fb1/syntaxes/plantuml.yaml-tmLanguage"
      },
      {
        "scopeName": "source.jinja",
        "path": "syntaxes/jinja.tmLanguage.json",
        "languageId": "jinja",
        "license": "MIT",
        "grammarSource": "https://github.com/samuelcolvin/jinjahtml-vscode/blob/be729c88f723602e7b5df2e9dc5e8c016c31c38f/syntaxes/jinja.tmLanguage.json"
      }
    ]
  }
}
