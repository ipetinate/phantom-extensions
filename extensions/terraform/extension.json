{
  "schemaVersion": 1,
  "id": "phantom.terraform",
  "name": "Terraform",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Terraform: highlighting and terraform-ls.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/terraform",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "terraform",
        "name": "Terraform",
        "extensions": [
          "tf",
          "tfvars"
        ],
        "category": "infrastructure",
        "icon": "icons/terraform.png",
        "lineComment": "#",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "terraform-ls",
          "args": [
            "serve"
          ],
          "installHint": "brew install hashicorp/tap/terraform-ls",
          "documentationURL": "https://github.com/hashicorp/terraform-ls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install hashicorp/tap/terraform-ls",
                "uninstall": "brew uninstall hashicorp/tap/terraform-ls"
              }
            ],
            "documentationURL": "https://github.com/hashicorp/terraform-ls/blob/main/docs/installation.md"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.hcl.terraform",
        "path": "syntaxes/terraform.tmLanguage.json",
        "languageId": "terraform",
        "license": "MPL-2.0",
        "grammarSource": "https://github.com/hashicorp/syntax/blob/16375ff2107c4d12551b1637bf17b371cf9ac103/syntaxes/terraform.tmGrammar.json"
      }
    ]
  }
}
