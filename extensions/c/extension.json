{
  "schemaVersion": 1,
  "id": "phantom.c",
  "name": "C",
  "version": "1.0.2",
  "publisher": "Phantom",
  "description": "C: highlighting and clangd.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/c",
  "phantom": "0.16.0",
  "contributes": {
    "languages": [
      {
        "languageId": "c",
        "name": "C",
        "extensions": [
          "c",
          "h"
        ],
        "category": "compiled",
        "icon": "icons/c.svg",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "keywords": [
          "_Atomic",
          "_BitInt",
          "_Bool",
          "_Complex",
          "_Generic",
          "_Imaginary",
          "_Noreturn",
          "alignas",
          "alignof",
          "auto",
          "bool",
          "break",
          "case",
          "char",
          "class",
          "const",
          "constexpr",
          "continue",
          "decltype",
          "default",
          "delete",
          "do",
          "double",
          "else",
          "enum",
          "explicit",
          "extern",
          "false",
          "float",
          "for",
          "goto",
          "if",
          "inline",
          "int",
          "long",
          "namespace",
          "new",
          "noexcept",
          "nullptr",
          "operator",
          "override",
          "private",
          "protected",
          "public",
          "register",
          "restrict",
          "return",
          "short",
          "signed",
          "sizeof",
          "static",
          "static_assert",
          "struct",
          "switch",
          "template",
          "this",
          "thread_local",
          "true",
          "typedef",
          "typename",
          "typeof",
          "typeof_unqual",
          "union",
          "unsigned",
          "using",
          "virtual",
          "void",
          "volatile",
          "while"
        ],
        "syntax": {
          "string": "(?:u8|[uUL])?\"(?:[^\"\\\\]|\\\\.)*\"|(?:u8|[uUL])?'(?:[^'\\\\]|\\\\.)*'",
          "number": "preset:number",
          "type": "\\b[A-Za-z_][A-Za-z0-9_]*_t\\b|\\b[A-Z][A-Za-z0-9_]*\\b",
          "function": "preset:callBeforeParen",
          "attribute": "^\\s*#\\s*[a-z_]+|\\[\\[[^\\]]*\\]\\]"
        },
        "server": {
          "command": "clangd",
          "installHint": "Ships with the Xcode Command Line Tools — run: xcode-select --install",
          "documentationURL": "https://clangd.llvm.org/",
          "install": {
            "documentationURL": "https://clangd.llvm.org/installation"
          }
        }
      }
    ]
  }
}
