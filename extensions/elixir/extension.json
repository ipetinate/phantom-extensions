{
  "schemaVersion": 1,
  "id": "ipetinate.elixir",
  "name": "Elixir",
  "version": "1.1.0",
  "publisher": "Isac Petinate",
  "description": "Elixir, EEx and HEEx: highlighting and ElixirLS.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/elixir",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.html"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "elixir",
        "name": "Elixir",
        "extensions": [
          "ex",
          "exs"
        ],
        "fileNames": [
          "mix.lock"
        ],
        "category": "script",
        "icon": "icons/elixir.png",
        "lineComment": "#",
        "server": {
          "command": "elixir-ls",
          "installHint": "brew install elixir-ls",
          "documentationURL": "https://github.com/elixir-lsp/elixir-ls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install elixir-ls",
                "uninstall": "brew uninstall elixir-ls"
              }
            ],
            "documentationURL": "https://github.com/elixir-lsp/elixir-ls"
          }
        }
      },
      {
        "languageId": "eex",
        "name": "Embedded Elixir",
        "extensions": [
          "eex",
          "leex"
        ],
        "category": "markup",
        "icon": "icons/elixir.png",
        "blockComment": {
          "open": "<%#",
          "close": "%>"
        },
        "server": {
          "command": "elixir-ls",
          "installHint": "brew install elixir-ls",
          "documentationURL": "https://github.com/elixir-lsp/elixir-ls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install elixir-ls",
                "uninstall": "brew uninstall elixir-ls"
              }
            ],
            "documentationURL": "https://github.com/elixir-lsp/elixir-ls"
          }
        }
      },
      {
        "languageId": "heex",
        "name": "HEEx",
        "extensions": [
          "heex"
        ],
        "category": "markup",
        "icon": "icons/elixir.png",
        "blockComment": {
          "open": "<%!--",
          "close": "--%>"
        },
        "server": {
          "command": "elixir-ls",
          "installHint": "brew install elixir-ls",
          "documentationURL": "https://github.com/elixir-lsp/elixir-ls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install elixir-ls",
                "uninstall": "brew uninstall elixir-ls"
              }
            ],
            "documentationURL": "https://github.com/elixir-lsp/elixir-ls"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.elixir",
        "path": "syntaxes/elixir.tmLanguage.json",
        "languageId": "elixir",
        "license": "MIT",
        "grammarSource": "https://github.com/elixir-lsp/vscode-elixir-ls/blob/c98bbfe025fc85205b554571fb687c901f702649/syntaxes/elixir.json",
        "embeddedLanguages": {
          "comment.documentation.heredoc.elixir": "markdown"
        }
      },
      {
        "scopeName": "text.elixir",
        "path": "syntaxes/eex.tmLanguage.json",
        "languageId": "eex",
        "license": "MIT",
        "grammarSource": "https://github.com/elixir-lsp/vscode-elixir-ls/blob/c98bbfe025fc85205b554571fb687c901f702649/syntaxes/eex.json"
      },
      {
        "scopeName": "text.html.elixir",
        "path": "syntaxes/html-eex.tmLanguage.json",
        "languageId": "heex",
        "license": "MIT",
        "grammarSource": "https://github.com/elixir-lsp/vscode-elixir-ls/blob/c98bbfe025fc85205b554571fb687c901f702649/syntaxes/html-eex.json"
      }
    ],
    "formatters": [
      {
        "id": "mix-format",
        "name": "mix format",
        "command": "mix",
        "args": [
          "format",
          "-"
        ],
        "extensions": [
          "ex",
          "exs"
        ],
        "projectMarkers": [
          "mix.exs"
        ],
        "workingDirectory": "marker",
        "installHint": "brew install elixir",
        "documentationURL": "https://hexdocs.pm/mix/Mix.Tasks.Format.html",
        "install": {
          "commands": [
            {
              "manager": "brew",
              "command": "brew install elixir",
              "uninstall": "brew uninstall elixir"
            }
          ],
          "documentationURL": "https://elixir-lang.org/install.html"
        }
      }
    ]
  }
}
