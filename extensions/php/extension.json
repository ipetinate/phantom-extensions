{
  "schemaVersion": 1,
  "id": "phantom.php",
  "name": "PHP",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "PHP: highlighting and Intelephense.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/php",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.css",
    "phantom.html",
    "phantom.json",
    "phantom.sql",
    "phantom.typescript",
    "phantom.xml"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "php",
        "name": "PHP",
        "extensions": [
          "php",
          "phtml"
        ],
        "category": "script",
        "icon": "icons/php.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "intelephense",
          "args": [
            "--stdio"
          ],
          "installHint": "npm install -g intelephense",
          "documentationURL": "https://intelephense.com/",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g intelephense",
                "uninstall": "npm rm -g intelephense"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g intelephense",
                "uninstall": "pnpm remove -g intelephense"
              }
            ],
            "documentationURL": "https://www.npmjs.com/package/intelephense"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.php",
        "path": "syntaxes/php.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/php/syntaxes/php.tmLanguage.json"
      },
      {
        "scopeName": "text.html.php",
        "path": "syntaxes/html-php.tmLanguage.json",
        "languageId": "php",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/php/syntaxes/html.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.php": "php",
          "source.sql": "sql",
          "text.xml": "xml",
          "source.js": "javascript",
          "source.json": "json",
          "source.css": "css"
        }
      }
    ]
  }
}
