{
  "schemaVersion": 1,
  "id": "phantom.json",
  "name": "JSON",
  "version": "1.0.3",
  "publisher": "Phantom",
  "description": "JSON and JSON with Comments: highlighting, vscode-json-language-server and schema completion.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/json",
  "phantom": "0.16.0",
  "contributes": {
    "languages": [
      {
        "languageId": "json",
        "name": "JSON",
        "extensions": [
          "json"
        ],
        "fileNames": [
          ".babelrc",
          ".eslintrc",
          ".jscsrc",
          ".jshintrc",
          ".prettierrc",
          ".swcrc"
        ],
        "category": "data",
        "icon": "icons/json.png",
        "keywords": [
          "true",
          "false",
          "null"
        ],
        "syntax": {
          "string": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "number": "preset:number",
          "attribute": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)"
        },
        "server": {
          "command": "vscode-json-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      },
      {
        "languageId": "jsonc",
        "name": "JSON with Comments",
        "extensions": [
          "jsonc"
        ],
        "category": "data",
        "icon": "icons/json.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "keywords": [
          "true",
          "false",
          "null"
        ],
        "syntax": {
          "string": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "number": "preset:number",
          "attribute": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)"
        },
        "server": {
          "command": "vscode-json-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      }
    ]
  }
}
