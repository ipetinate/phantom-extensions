{
  "schemaVersion": 1,
  "id": "phantom.json",
  "name": "JSON",
  "version": "1.0.7",
  "publisher": "Isac Petinate",
  "description": "JSON, JSON with Comments and JSON Lines: highlighting, vscode-json-language-server and schema completion.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/json",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "json",
        "name": "JSON",
        "extensions": [
          "json"
        ],
        "fileNames": [
          ".babelrc",
          ".eslintrc",
          ".jscsrc",
          ".jshintrc",
          ".prettierrc",
          ".swcrc"
        ],
        "category": "data",
        "icon": "icons/json.png",
        "server": {
          "command": "vscode-json-language-server",
          "args": [
            "--stdio"
          ],
          "initializationOptions": {
            "provideFormatter": true
          },
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      },
      {
        "languageId": "jsonc",
        "name": "JSON with Comments",
        "extensions": [
          "jsonc"
        ],
        "category": "data",
        "icon": "icons/json.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "vscode-json-language-server",
          "args": [
            "--stdio"
          ],
          "initializationOptions": {
            "provideFormatter": true
          },
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      },
      {
        "languageId": "jsonl",
        "name": "JSON Lines",
        "extensions": [
          "jsonl",
          "ndjson"
        ],
        "category": "data",
        "icon": "icons/json.png"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.json",
        "path": "syntaxes/json.tmLanguage.json",
        "languageId": "json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/json/syntaxes/JSON.tmLanguage.json"
      },
      {
        "scopeName": "source.json.comments",
        "path": "syntaxes/jsonc.tmLanguage.json",
        "languageId": "jsonc",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/json/syntaxes/JSONC.tmLanguage.json"
      },
      {
        "scopeName": "source.json.lines",
        "path": "syntaxes/jsonl.tmLanguage.json",
        "languageId": "jsonl",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/json/syntaxes/JSONL.tmLanguage.json"
      }
    ]
  }
}
