{
  "schemaVersion": 1,
  "id": "phantom.swift",
  "name": "Swift",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Swift: highlighting and SourceKit-LSP, the server that ships with Xcode.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/swift",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "swift",
        "name": "Swift",
        "extensions": [
          "swift",
          "swiftinterface"
        ],
        "category": "compiled",
        "icon": "icons/swift.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "sourcekit-lsp",
          "args": [],
          "installHint": "Ships with Xcode — run: xcode-select --install",
          "documentationURL": "https://github.com/swiftlang/sourcekit-lsp",
          "install": {
            "documentationURL": "https://github.com/swiftlang/sourcekit-lsp"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.swift",
        "path": "syntaxes/swift.tmLanguage.json",
        "languageId": "swift",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/swift/syntaxes/swift.tmLanguage.json"
      }
    ]
  }
}
