{
  "schemaVersion": 1,
  "id": "phantom.swift",
  "name": "Swift",
  "version": "1.0.3",
  "publisher": "Phantom",
  "description": "Swift: highlighting and SourceKit-LSP, the server that ships with Xcode.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/swift",
  "phantom": "0.16.0",
  "contributes": {
    "languages": [
      {
        "languageId": "swift",
        "name": "Swift",
        "extensions": [
          "swift",
          "swiftinterface"
        ],
        "category": "compiled",
        "icon": "icons/swift.png",
        "keywords": [
          "actor",
          "any",
          "as",
          "associatedtype",
          "async",
          "await",
          "break",
          "case",
          "catch",
          "class",
          "consuming",
          "continue",
          "convenience",
          "default",
          "defer",
          "deinit",
          "didSet",
          "do",
          "dynamic",
          "each",
          "else",
          "enum",
          "extension",
          "fallthrough",
          "fileprivate",
          "final",
          "for",
          "func",
          "get",
          "guard",
          "if",
          "import",
          "in",
          "indirect",
          "infix",
          "init",
          "inout",
          "internal",
          "is",
          "lazy",
          "let",
          "mutating",
          "nil",
          "nonisolated",
          "nonmutating",
          "open",
          "operator",
          "optional",
          "override",
          "package",
          "postfix",
          "precedencegroup",
          "prefix",
          "private",
          "protocol",
          "public",
          "repeat",
          "required",
          "rethrows",
          "return",
          "self",
          "Self",
          "set",
          "some",
          "static",
          "struct",
          "subscript",
          "super",
          "switch",
          "throw",
          "throws",
          "try",
          "typealias",
          "unowned",
          "var",
          "weak",
          "where",
          "while",
          "willSet",
          "true",
          "false"
        ],
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "syntax": {
          "string": "\"\"\"[\\s\\S]*?\"\"\"|\"(?:[^\"\\\\]|\\\\.)*\"",
          "number": "preset:number",
          "type": "preset:capitalizedType",
          "function": "preset:callBeforeParen",
          "attribute": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        "server": {
          "command": "sourcekit-lsp",
          "args": [],
          "installHint": "Ships with Xcode — run: xcode-select --install",
          "documentationURL": "https://github.com/swiftlang/sourcekit-lsp",
          "install": {
            "documentationURL": "https://github.com/swiftlang/sourcekit-lsp"
          }
        }
      }
    ]
  }
}
