{
  "schemaVersion": 1,
  "id": "ipetinate.prettier",
  "name": "Prettier",
  "version": "1.0.0",
  "publisher": "ipetinate",
  "description": "Prettier: opinionated formatting for the files it has a parser for, in projects that declare it.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/prettier",
  "phantom": "0.17.0",
  "contributes": {
    "formatters": [
      {
        "id": "prettier",
        "name": "Prettier",
        "command": "prettier",
        "args": [
          "--stdin-filepath",
          "$FILE"
        ],
        "extensions": [
          "_js",
          "avsc",
          "bones",
          "cjs",
          "code-snippets",
          "code-workspace",
          "css",
          "cts",
          "es",
          "es6",
          "geojson",
          "gltf",
          "gql",
          "graphql",
          "graphqls",
          "gs",
          "handlebars",
          "har",
          "hbs",
          "hta",
          "htm",
          "html",
          "ice",
          "importmap",
          "jake",
          "javascript",
          "js",
          "jsb",
          "jscad",
          "jsfl",
          "jslib",
          "jsm",
          "json",
          "json5",
          "jsonc",
          "jspre",
          "jss",
          "jsx",
          "less",
          "livemd",
          "markdown",
          "mcmeta",
          "md",
          "mdown",
          "mdwn",
          "mdx",
          "mir",
          "mjml",
          "mjs",
          "mkd",
          "mkdn",
          "mkdown",
          "mts",
          "njs",
          "pac",
          "pcss",
          "postcss",
          "reek",
          "ronn",
          "rviz",
          "sarif",
          "scd",
          "scss",
          "sjs",
          "slnlaunch",
          "ssjs",
          "sublime-build",
          "sublime-color-scheme",
          "sublime-commands",
          "sublime-completions",
          "sublime-keymap",
          "sublime-macro",
          "sublime-menu",
          "sublime-mousemap",
          "sublime-project",
          "sublime-settings",
          "sublime-syntax",
          "sublime-theme",
          "sublime-workspace",
          "sublime_metrics",
          "sublime_session",
          "syntax",
          "tact",
          "tfstate",
          "topojson",
          "ts",
          "tsx",
          "vue",
          "webapp",
          "webmanifest",
          "workbook",
          "wxs",
          "wxss",
          "xht",
          "xhtml",
          "xsjs",
          "xsjslib",
          "yaml",
          "yaml-tmlanguage",
          "yml",
          "yy",
          "yyp"
        ],
        "projectMarkers": [
          ".prettierrc",
          ".prettierrc.json",
          ".prettierrc.json5",
          ".prettierrc.yaml",
          ".prettierrc.yml",
          ".prettierrc.toml",
          ".prettierrc.js",
          ".prettierrc.cjs",
          ".prettierrc.mjs",
          ".prettierrc.ts",
          ".prettierrc.mts",
          ".prettierrc.cts",
          "prettier.config.js",
          "prettier.config.cjs",
          "prettier.config.mjs",
          "prettier.config.ts",
          "prettier.config.mts",
          "prettier.config.cts",
          {
            "file": "package.json",
            "containsKey": "prettier"
          },
          {
            "file": "package.yaml",
            "containsKey": "prettier"
          }
        ],
        "localBinary": "node_modules/.bin/prettier",
        "workingDirectory": "marker",
        "installHint": "npm install --global prettier",
        "documentationURL": "https://prettier.io/docs/",
        "install": {
          "commands": [
            {
              "manager": "npm",
              "command": "npm install --global prettier",
              "uninstall": "npm uninstall --global prettier"
            },
            {
              "manager": "brew",
              "command": "brew install prettier",
              "uninstall": "brew uninstall prettier"
            }
          ],
          "documentationURL": "https://prettier.io/docs/install"
        }
      }
    ]
  }
}
