{
  "schemaVersion": 1,
  "id": "phantom.toml",
  "name": "TOML",
  "version": "1.0.5",
  "publisher": "Isac Petinate",
  "description": "TOML: highlighting and the Taplo language server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/toml",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "toml",
        "name": "TOML",
        "extensions": [
          "toml"
        ],
        "fileNames": [
          "Cargo.lock"
        ],
        "category": "data",
        "icon": "icons/toml.png",
        "lineComment": "#",
        "server": {
          "command": "taplo",
          "args": [
            "lsp",
            "stdio"
          ],
          "installHint": "brew install taplo",
          "documentationURL": "https://taplo.tamasfe.dev/cli/usage/language-server.html",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install taplo",
                "uninstall": "brew uninstall taplo"
              },
              {
                "manager": "cargo",
                "command": "cargo install taplo-cli --locked --features lsp",
                "uninstall": "cargo uninstall taplo-cli"
              }
            ],
            "documentationURL": "https://taplo.tamasfe.dev/cli/installation/cargo.html"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.toml",
        "path": "syntaxes/toml.tmLanguage.json",
        "languageId": "toml",
        "license": "MIT",
        "grammarSource": "https://github.com/tamasfe/taplo/blob/08f343be02ce1b20296470396a42f0fa47820449/editors/vscode/toml.tmLanguage.json"
      },
      {
        "scopeName": "markdown.toml.frontmatter.codeblock",
        "path": "syntaxes/toml-frontmatter.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/tamasfe/taplo/blob/08f343be02ce1b20296470396a42f0fa47820449/editors/vscode/toml.frontmatter.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "scopeName": "markdown.toml.codeblock",
        "path": "syntaxes/toml-markdown.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/tamasfe/taplo/blob/08f343be02ce1b20296470396a42f0fa47820449/editors/vscode/toml.markdown.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.toml": "toml"
        },
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  }
}
