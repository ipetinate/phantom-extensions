{
  "schemaVersion": 1,
  "id": "phantom.go",
  "name": "Go",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Go: highlighting, go.mod and go.sum, and the gopls language server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/go",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "go",
        "name": "Go",
        "extensions": [
          "go"
        ],
        "fileNames": [
          "go.mod",
          "go.sum",
          "go.work"
        ],
        "category": "compiled",
        "icon": "icons/go.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "gopls",
          "args": [],
          "installHint": "brew install gopls",
          "documentationURL": "https://go.dev/gopls",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install gopls",
                "uninstall": "brew uninstall gopls"
              },
              {
                "manager": "go",
                "command": "go install golang.org/x/tools/gopls@latest"
              }
            ],
            "documentationURL": "https://go.dev/gopls"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.go",
        "path": "syntaxes/go.tmLanguage.json",
        "languageId": "go",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/go/syntaxes/go.tmLanguage.json"
      }
    ]
  }
}
