{
  "schemaVersion": 1,
  "id": "phantom.ruby",
  "name": "Ruby",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Ruby: highlighting and Ruby LSP.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/ruby",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.c",
    "phantom.css",
    "phantom.html",
    "ipetinate.lua",
    "phantom.shell",
    "phantom.sql",
    "phantom.typescript",
    "phantom.xml",
    "phantom.yaml"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "ruby",
        "name": "Ruby",
        "extensions": [
          "rb",
          "rake",
          "gemspec",
          "ru"
        ],
        "fileNames": [
          "Gemfile",
          "Rakefile",
          "Guardfile",
          "Capfile",
          "Vagrantfile",
          "Podfile",
          "Brewfile"
        ],
        "category": "script",
        "icon": "icons/ruby.png",
        "lineComment": "#",
        "server": {
          "command": "ruby-lsp",
          "installHint": "brew install ruby-lsp",
          "documentationURL": "https://shopify.github.io/ruby-lsp/",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install ruby-lsp",
                "uninstall": "brew uninstall ruby-lsp"
              },
              {
                "manager": "gem",
                "command": "gem install ruby-lsp",
                "uninstall": "gem uninstall ruby-lsp"
              }
            ],
            "documentationURL": "https://shopify.github.io/ruby-lsp/editors.html"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.ruby",
        "path": "syntaxes/ruby.tmLanguage.json",
        "languageId": "ruby",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/ruby/syntaxes/ruby.tmLanguage.json"
      }
    ]
  }
}
