{
  "schemaVersion": 1,
  "id": "phantom.zig",
  "name": "Zig",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Zig: highlighting for .zig and .zon, and the ZLS language server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/zig",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "zig",
        "name": "Zig",
        "extensions": [
          "zig",
          "zon"
        ],
        "category": "compiled",
        "icon": "icons/zig.png",
        "lineComment": "//",
        "server": {
          "command": "zls",
          "args": [],
          "installHint": "brew install zls",
          "documentationURL": "https://zigtools.org/zls/",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install zls",
                "uninstall": "brew uninstall zls"
              }
            ],
            "documentationURL": "https://zigtools.org/zls/install/"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.zig",
        "path": "syntaxes/zig.tmLanguage.json",
        "languageId": "zig",
        "license": "MIT",
        "grammarSource": "https://github.com/ziglang/vscode-zig/blob/38309f0b1dc0c1bdc4b23e78594302bf28ef43d1/syntaxes/zig.tmLanguage.json"
      }
    ]
  }
}
