{
  "schemaVersion": 1,
  "id": "phantom.yaml",
  "name": "YAML",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "YAML: highlighting, yaml-language-server and schema validation.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/yaml",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "yaml",
        "name": "YAML",
        "extensions": [
          "yaml",
          "yml"
        ],
        "category": "data",
        "icon": "icons/yaml.png",
        "lineComment": "#",
        "server": {
          "command": "yaml-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g yaml-language-server",
          "documentationURL": "https://github.com/redhat-developer/yaml-language-server",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g yaml-language-server",
                "uninstall": "npm rm -g yaml-language-server"
              },
              {
                "manager": "brew",
                "command": "brew install yaml-language-server",
                "uninstall": "brew uninstall yaml-language-server"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g yaml-language-server",
                "uninstall": "pnpm remove -g yaml-language-server"
              }
            ],
            "documentationURL": "https://github.com/redhat-developer/yaml-language-server"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.yaml",
        "path": "syntaxes/yaml.tmLanguage.json",
        "languageId": "yaml",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/yaml/syntaxes/yaml.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.0",
        "path": "syntaxes/yaml-1.0.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/yaml/syntaxes/yaml-1.0.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.1",
        "path": "syntaxes/yaml-1.1.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/yaml/syntaxes/yaml-1.1.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.2",
        "path": "syntaxes/yaml-1.2.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/yaml/syntaxes/yaml-1.2.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.3",
        "path": "syntaxes/yaml-1.3.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/yaml/syntaxes/yaml-1.3.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.embedded",
        "path": "syntaxes/yaml-embedded.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/yaml/syntaxes/yaml-embedded.tmLanguage.json"
      }
    ]
  }
}
