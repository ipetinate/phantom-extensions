{
  "schemaVersion": 1,
  "id": "phantom.xml",
  "name": "XML",
  "version": "1.0.5",
  "publisher": "Isac Petinate",
  "description": "XML: highlighting for the whole family of XML file types, and xmllint formatting for the ones Phantom does not already format.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/xml",
  "phantom": "0.16.0",
  "contributes": {
    "languages": [
      {
        "languageId": "xml",
        "name": "XML",
        "extensions": [
          "xml",
          "xsd",
          "xsl",
          "xslt",
          "svg",
          "plist",
          "storyboard",
          "xib",
          "csproj",
          "vbproj",
          "props",
          "targets",
          "resx",
          "xaml",
          "wsdl",
          "rss",
          "atom",
          "iml",
          "nuspec",
          "opf"
        ],
        "category": "markup",
        "icon": "icons/xml.png",
        "blockComment": {
          "open": "<!--",
          "close": "-->"
        },
        "syntax": {
          "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
          "type": "</?[A-Za-z_][A-Za-z0-9_.:-]*|<\\?[A-Za-z-]+|<!\\[CDATA\\[|\\]\\]>",
          "attribute": "\\b[A-Za-z_:][-A-Za-z0-9_:.]*(?=\\s*=)",
          "function": "&[A-Za-z][A-Za-z0-9]*;|&#[0-9]+;|&#x[0-9A-Fa-f]+;"
        }
      }
    ],
    "formatters": [
      {
        "id": "xmllint-project-files",
        "name": "xmllint",
        "command": "xmllint",
        "args": [
          "--format",
          "-"
        ],
        "extensions": [
          "csproj",
          "vbproj",
          "props",
          "targets",
          "resx",
          "xaml",
          "wsdl",
          "rss",
          "atom",
          "iml",
          "nuspec",
          "opf"
        ],
        "installHint": "Ships with macOS at /usr/bin/xmllint",
        "documentationURL": "https://gnome.pages.gitlab.gnome.org/libxml2/xmllint.html"
      }
    ]
  }
}
