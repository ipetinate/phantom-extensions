{
  "schemaVersion": 1,
  "id": "phantom.xml",
  "name": "XML",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "XML: highlighting for the whole family of XML file types, and xmllint formatting for the ones Phantom does not already format.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/xml",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.java"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "xml",
        "name": "XML",
        "extensions": [
          "xml",
          "xsd",
          "xsl",
          "xslt",
          "svg",
          "plist",
          "storyboard",
          "xib",
          "csproj",
          "vbproj",
          "props",
          "targets",
          "resx",
          "xaml",
          "wsdl",
          "rss",
          "atom",
          "iml",
          "nuspec",
          "opf"
        ],
        "category": "markup",
        "icon": "icons/xml.png",
        "blockComment": {
          "open": "<!--",
          "close": "-->"
        }
      }
    ],
    "formatters": [
      {
        "id": "xmllint-project-files",
        "name": "xmllint",
        "command": "xmllint",
        "args": [
          "--format",
          "-"
        ],
        "extensions": [
          "csproj",
          "vbproj",
          "props",
          "targets",
          "resx",
          "xaml",
          "wsdl",
          "rss",
          "atom",
          "iml",
          "nuspec",
          "opf"
        ],
        "installHint": "Ships with macOS at /usr/bin/xmllint",
        "documentationURL": "https://gnome.pages.gitlab.gnome.org/libxml2/xmllint.html"
      }
    ],
    "grammars": [
      {
        "scopeName": "text.xml",
        "path": "syntaxes/xml.tmLanguage.json",
        "languageId": "xml",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/xml/syntaxes/xml.tmLanguage.json"
      },
      {
        "scopeName": "text.xml.xsl",
        "path": "syntaxes/xsl.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/xml/syntaxes/xsl.tmLanguage.json"
      }
    ]
  }
}
