{
  "schemaVersion": 1,
  "id": "phantom.sql",
  "name": "SQL",
  "version": "1.0.4",
  "publisher": "Isac Petinate",
  "description": "SQL: highlighting only. No language server and no formatter.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/sql",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "sql",
        "name": "SQL",
        "extensions": [
          "sql",
          "ddl",
          "dml",
          "pgsql",
          "mysql",
          "tsql"
        ],
        "category": "data",
        "icon": "icons/sql.png",
        "lineComment": "--",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.sql",
        "path": "syntaxes/sql.tmLanguage.json",
        "languageId": "sql",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/sql/syntaxes/sql.tmLanguage.json"
      }
    ]
  }
}
