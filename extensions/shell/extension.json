{
  "schemaVersion": 1,
  "id": "phantom.shell",
  "name": "Shell Script",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Shell scripts: highlighting, bash-language-server and shfmt.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/shell",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "shellscript",
        "name": "Shell Script",
        "extensions": [
          "sh",
          "bash",
          "zsh",
          "ksh",
          "bats",
          "command"
        ],
        "fileNames": [
          ".bashrc",
          ".bash_profile",
          ".bash_login",
          ".bash_logout",
          ".bash_aliases",
          ".profile",
          ".zshrc",
          ".zshenv",
          ".zprofile",
          ".zlogin",
          ".zlogout",
          ".kshrc"
        ],
        "category": "script",
        "icon": "icons/shell.png",
        "lineComment": "#",
        "server": {
          "command": "bash-language-server",
          "args": [
            "start"
          ],
          "installHint": "brew install bash-language-server",
          "documentationURL": "https://github.com/bash-lsp/bash-language-server",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install bash-language-server",
                "uninstall": "brew uninstall bash-language-server"
              },
              {
                "manager": "npm",
                "command": "npm install -g bash-language-server",
                "uninstall": "npm uninstall -g bash-language-server"
              }
            ],
            "documentationURL": "https://github.com/bash-lsp/bash-language-server"
          }
        }
      }
    ],
    "formatters": [
      {
        "id": "shfmt",
        "name": "shfmt",
        "command": "shfmt",
        "args": [
          "--filename",
          "$FILE"
        ],
        "extensions": [
          "sh",
          "bash",
          "zsh",
          "ksh",
          "bats",
          "command"
        ],
        "installHint": "brew install shfmt",
        "documentationURL": "https://github.com/mvdan/sh",
        "install": {
          "commands": [
            {
              "manager": "brew",
              "command": "brew install shfmt",
              "uninstall": "brew uninstall shfmt"
            },
            {
              "manager": "go",
              "command": "go install mvdan.cc/sh/v3/cmd/shfmt@latest"
            }
          ],
          "documentationURL": "https://github.com/mvdan/sh"
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.shell",
        "path": "syntaxes/shell-unix-bash.tmLanguage.json",
        "languageId": "shellscript",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/shellscript/syntaxes/shell-unix-bash.tmLanguage.json"
      }
    ]
  }
}
