{
  "schemaVersion": 1,
  "id": "ipetinate.nix",
  "name": "Nix",
  "version": "1.0.0",
  "publisher": "Isac Petinate",
  "description": "Nix: highlighting for Nix expressions and flakes.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/nix",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
