        "languageId": "nix",
        "license": "MIT",
        "grammarSource": "https://github.com/nix-community/vscode-nix-ide/blob/effbf3494a43250a537834805b305793994b9ca8/dist/nix.tmLanguage.json"
      }
    ]
  }
}
