{
  "schemaVersion": 1,
  "id": "phantom.css",
  "name": "CSS",
  "version": "1.0.5",
  "publisher": "Isac Petinate",
  "description": "CSS, SCSS and Less: highlighting and vscode-css-language-server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/css",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "css",
        "name": "CSS",
        "extensions": [
          "css"
        ],
        "category": "styles",
        "icon": "icons/css.png",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "vscode-css-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      },
      {
        "languageId": "scss",
        "name": "SCSS",
        "extensions": [
          "scss"
        ],
        "category": "styles",
        "icon": "icons/css.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "vscode-css-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      },
      {
        "languageId": "less",
        "name": "Less",
        "extensions": [
          "less"
        ],
        "category": "styles",
        "icon": "icons/css.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "vscode-css-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.css",
        "path": "syntaxes/css.tmLanguage.json",
        "languageId": "css",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/css/syntaxes/css.tmLanguage.json"
      },
      {
        "scopeName": "source.css.scss",
        "path": "syntaxes/scss.tmLanguage.json",
        "languageId": "scss",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/scss/syntaxes/scss.tmLanguage.json"
      },
      {
        "scopeName": "source.css.less",
        "path": "syntaxes/less.tmLanguage.json",
        "languageId": "less",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/less/syntaxes/less.tmLanguage.json"
      }
    ]
  }
}
