{
  "schemaVersion": 1,
  "id": "phantom.html",
  "name": "HTML",
  "version": "1.0.0",
  "publisher": "Phantom",
  "description": "HTML: highlighting, vscode-html-language-server and the formatter it ships.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/html",
  "phantom": "0.16.0",
  "contributes": {
    "languages": [
      {
        "languageId": "html",
        "name": "HTML",
        "extensions": [
          "html",
          "htm",
          "xhtml"
        ],
        "category": "markup",
        "icon": "icons/html.svg",
        "blockComment": {
          "open": "<!--",
          "close": "-->"
        },
        "syntax": {
          "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
          "type": "</?[A-Za-z][A-Za-z0-9-]*|<!DOCTYPE",
          "attribute": "\\b[A-Za-z_:@#$*][-A-Za-z0-9_:.]*(?=\\s*=)",
          "function": "&[A-Za-z][A-Za-z0-9]*;|&#[0-9]+;"
        },
        "server": {
          "command": "vscode-html-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      }
    ]
  }
}
