{
  "schemaVersion": 1,
  "id": "phantom.html",
  "name": "HTML",
  "version": "1.0.5",
  "publisher": "Isac Petinate",
  "description": "HTML: highlighting, vscode-html-language-server and the formatter it ships.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/html",
  "phantom": "0.17.0",
  "dependencies": [
    "phantom.css",
    "phantom.typescript"
  ],
  "contributes": {
    "languages": [
      {
        "languageId": "html",
        "name": "HTML",
        "extensions": [
          "html",
          "htm",
          "xhtml"
        ],
        "category": "markup",
        "icon": "icons/html.png",
        "blockComment": {
          "open": "<!--",
          "close": "-->"
        },
        "server": {
          "command": "vscode-html-language-server",
          "args": [
            "--stdio"
          ],
          "installHint": "npm i -g vscode-langservers-extracted",
          "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted",
          "install": {
            "commands": [
              {
                "manager": "npm",
                "command": "npm install -g vscode-langservers-extracted",
                "uninstall": "npm rm -g vscode-langservers-extracted"
              },
              {
                "manager": "pnpm",
                "command": "pnpm add -g vscode-langservers-extracted",
                "uninstall": "pnpm remove -g vscode-langservers-extracted"
              },
              {
                "manager": "yarn",
                "command": "yarn global add vscode-langservers-extracted",
                "uninstall": "yarn global remove vscode-langservers-extracted"
              }
            ],
            "documentationURL": "https://github.com/hrsh7th/vscode-langservers-extracted"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "text.html.basic",
        "path": "syntaxes/html.tmLanguage.json",
        "license": "TextMate Bundle License",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/html/syntaxes/html.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.css": "css",
          "source.js": "javascript",
          "source.python": "python",
          "source.smarty": "smarty"
        }
      },
      {
        "scopeName": "text.html.derivative",
        "path": "syntaxes/html-derivative.tmLanguage.json",
        "languageId": "html",
        "license": "TextMate Bundle License",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/html/syntaxes/html-derivative.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.css": "css",
          "source.js": "javascript",
          "source.python": "python",
          "source.smarty": "smarty"
        }
      }
    ]
  }
}
