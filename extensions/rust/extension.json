{
  "schemaVersion": 1,
  "id": "phantom.rust",
  "name": "Rust",
  "version": "1.0.6",
  "publisher": "Isac Petinate",
  "description": "Rust: highlighting, attributes and the rust-analyzer language server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/rust",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "rust",
        "name": "Rust",
        "extensions": [
          "rs"
        ],
        "category": "compiled",
        "icon": "icons/rust.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "rust-analyzer",
          "args": [],
          "installHint": "brew install rust-analyzer",
          "documentationURL": "https://rust-analyzer.github.io",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install rust-analyzer",
                "uninstall": "brew uninstall rust-analyzer"
              }
            ],
            "documentationURL": "https://rust-analyzer.github.io/book/rust_analyzer_binary.html"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.rust",
        "path": "syntaxes/rust.tmLanguage.json",
        "languageId": "rust",
        "license": "MIT",
        "grammarSource": "https://github.com/microsoft/vscode/blob/3d7cfab6d77dce362755ac573a7a350e8f64528f/extensions/rust/syntaxes/rust.tmLanguage.json"
      }
    ]
  }
}
