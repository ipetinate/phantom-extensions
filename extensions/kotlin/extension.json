{
  "schemaVersion": 1,
  "id": "phantom.kotlin",
  "name": "Kotlin",
  "version": "1.0.7",
  "publisher": "Isac Petinate",
  "description": "Kotlin: highlighting and the Kotlin Language Server.",
  "homepage": "https://github.com/ipetinate/phantom-extensions/tree/main/extensions/kotlin",
  "phantom": "0.17.0",
  "contributes": {
    "languages": [
      {
        "languageId": "kotlin",
        "name": "Kotlin",
        "extensions": [
          "kt",
          "kts"
        ],
        "category": "compiled",
        "icon": "icons/kotlin.png",
        "lineComment": "//",
        "blockComment": {
          "open": "/*",
          "close": "*/"
        },
        "server": {
          "command": "kotlin-language-server",
          "maximumJavaFeatureVersion": 21,
          "installHint": "brew install kotlin-language-server",
          "documentationURL": "https://github.com/fwcd/kotlin-language-server",
          "install": {
            "commands": [
              {
                "manager": "brew",
                "command": "brew install kotlin-language-server",
                "uninstall": "brew uninstall kotlin-language-server"
              }
            ],
            "documentationURL": "https://github.com/fwcd/kotlin-language-server/blob/main/EDITORS.md"
          }
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "source.kotlin",
        "path": "syntaxes/kotlin.tmLanguage.json",
        "languageId": "kotlin",
        "license": "MIT",
        "grammarSource": "https://github.com/fwcd/vscode-kotlin/blob/4a7c1538754828c1d22a8bee8ff3400045b4352a/syntaxes/kotlin.tmLanguage.json"
      },
      {
        "scopeName": "markdown.kotlin.codeblock",
        "path": "syntaxes/kotlin-codeblock.tmLanguage.json",
        "license": "MIT",
        "grammarSource": "https://github.com/fwcd/vscode-kotlin/blob/4a7c1538754828c1d22a8bee8ff3400045b4352a/syntaxes/kotlin-codeblock.json",
        "embeddedLanguages": {
          "meta.embedded.block.kotlin": "kotlin"
        },
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  }
}
