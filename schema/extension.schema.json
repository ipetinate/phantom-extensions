{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ipetinate/phantom-extensions/schema/extension.schema.json",
  "title": "Phantom extension manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "contributes"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "phantom": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Lowest Phantom version that reads every key in this manifest."
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "description": "Ids of the extensions whose grammars this extension's grammars include. Every scope an include names must belong to this extension or to one listed here, when an extension in the registry provides it."
    },
    "contributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/companionServer"
          },
          "description": "Servers that attach beside a language's own server, for several languages, only when the project uses the tool they serve."
        },
        "formatters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formatter"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theme"
          }
        },
        "iconThemes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/iconTheme"
          }
        },
        "grammars": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/grammar"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
    },
    "installManager": {
      "enum": [
        "brew",
        "npm",
        "pnpm",
        "yarn",
        "cargo",
        "gem",
        "pipx",
        "go",
        "dotnet",
        "nix"
      ]
    },
    "installCommand": {
      "type": "object",
      "required": [
        "manager",
        "command"
      ],
      "properties": {
        "manager": {
          "$ref": "#/$defs/installManager"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Starts with the manager's own binary; no curl, pipes, sudo, ;, &&, &, $( ), backticks or redirects."
        },
        "uninstall": {
          "type": "string",
          "minLength": 1,
          "description": "Removes what command installed, under the same rules."
        }
      }
    },
    "install": {
      "type": "object",
      "description": "How Phantom installs the program this entry names. installHint stays the sentence shown when there is no install block.",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/installCommand"
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "The older form: one command whose first word is its package manager."
              }
            ]
          }
        },
        "documentationURL": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "serverArgument": {
      "type": "string",
      "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{HOME\\})*$",
      "description": "One argument for the server. Phantom replaces ${HOME} with the user's home directory and expands nothing else, so no other ${...} token may appear."
    },
    "resolver": {
      "type": "object",
      "description": "A capability Phantom implements for glue a manifest cannot express as data. The extension names the capability; Phantom does the resolving.",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "title": "typescriptSDKArgument",
          "description": "Phantom finds the project's TypeScript lib directory and appends --tsdk=<dir> to args.",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "typescriptSDKArgument"
            }
          }
        },
        {
          "title": "typescriptPluginHost",
          "description": "Phantom resolves the project's tsserver.js and the plugin's location, and builds the tsserver initializationOptions that load that plugin for those languages.",
          "additionalProperties": false,
          "required": [
            "kind",
            "plugin",
            "languages"
          ],
          "properties": {
            "kind": {
              "const": "typescriptPluginHost"
            },
            "plugin": {
              "type": "string",
              "minLength": 1,
              "description": "The npm package name of the tsserver plugin, such as @vue/typescript-plugin."
            },
            "languages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_+-]+$"
              },
              "description": "The language ids the plugin serves inside the host process."
            }
          }
        }
      ]
    },
    "server": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serverArgument"
          }
        },
        "initializationOptions": {
          "type": "object"
        },
        "maximumJavaFeatureVersion": {
          "type": "integer",
          "minimum": 8,
          "maximum": 99,
          "description": "The newest Java feature version this server runs on. A ceiling, not a requirement: Phantom hands the server an older JVM when the environment's is above it."
        },
        "resolver": {
          "$ref": "#/$defs/resolver"
        },
        "installHint": {
          "type": "string"
        },
        "documentationURL": {
          "type": "string",
          "format": "uri"
        },
        "install": {
          "$ref": "#/$defs/install"
        }
      }
    },
    "companionServer": {
      "type": "object",
      "description": "A server that attaches beside the server of the language being edited. Phantom walks up from the file to the workspace root looking for any one of projectMarkers, and starts the server only when it finds one; no markers means always.",
      "allOf": [
        {
          "$ref": "#/$defs/server"
        }
      ],
      "required": [
        "id",
        "name",
        "command",
        "languageIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Names the server inside this extension; no two servers of one extension share it."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The name Settings shows for the server."
        },
        "languageIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_+-]+$"
          },
          "description": "The documents this server is offered for, by language id, from any extension."
        },
        "projectMarkers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/projectRelativePath"
          },
          "description": "Files or directories whose presence means the project uses the tool. Phantom walks up from the edited file to the workspace root; when it finds none, the server does not start. An absent or empty list starts the server for every project."
        }
      }
    },
    "language": {
      "type": "object",
      "required": [
        "languageId",
        "name",
        "extensions"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "pattern": "^[a-z0-9_+-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_+-]+$"
          },
          "minItems": 1
        },
        "fileNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "category": {
          "enum": [
            "script",
            "compiled",
            "markup",
            "frontendFramework",
            "styles",
            "data",
            "infrastructure"
          ]
        },
        "icon": {
          "$ref": "#/$defs/relativePath"
        },
        "lineComment": {
          "type": "string",
          "minLength": 1
        },
        "blockComment": {
          "type": "object",
          "required": [
            "open",
            "close"
          ],
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1
            },
            "close": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "server": {
          "$ref": "#/$defs/server"
        }
      }
    },
    "formatter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "command",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "$FILE stands for the path of the file being formatted."
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_+-]+$"
          },
          "minItems": 1
        },
        "projectMarkers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectMarker"
          },
          "minItems": 1,
          "maxItems": 32,
          "description": "Files whose presence means the project adopted this tool, in order of preference. When none is found on the walk up from the file, the formatter does not run on a save."
        },
        "localBinary": {
          "allOf": [
            {
              "$ref": "#/$defs/projectRelativePath"
            }
          ],
          "description": "The tool installed into the project, relative to a directory on the walk. Preferred over the PATH lookup when found."
        },
        "workingDirectory": {
          "enum": [
            "marker",
            "file",
            "workspace"
          ],
          "default": "file",
          "description": "Where the tool runs: beside the marker that was found, beside the file, or at the repository root."
        },
        "installHint": {
          "type": "string"
        },
        "documentationURL": {
          "type": "string",
          "format": "uri"
        },
        "install": {
          "$ref": "#/$defs/install"
        }
      }
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!/|~|\\./)(?!(.*/)?\\.\\.?(/|$))[^/]+(/[^/]+)*$"
    },
    "projectMarker": {
      "oneOf": [
        {
          "$ref": "#/$defs/projectRelativePath"
        },
        {
          "type": "object",
          "required": [
            "file",
            "containsKey"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "allOf": [
                {
                  "$ref": "#/$defs/projectRelativePath"
                },
                {
                  "type": "string",
                  "pattern": "\\.(json|ya?ml)$"
                }
              ],
              "description": "A manifest the tool is declared inside. Only JSON and YAML are read."
            },
            "containsKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "The top-level key whose presence declares the tool. Its value is never read."
            }
          }
        }
      ]
    },
    "theme": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath",
          "description": "A Ghostty theme file."
        },
        "appearance": {
          "enum": [
            "dark",
            "light"
          ]
        }
      }
    },
    "iconTheme": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath",
          "description": "Directory holding a VS Code style *icon-theme.json and its SVGs."
        }
      }
    },
    "scopeName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_+-]+(\\.[A-Za-z0-9_+-]+)+$",
      "description": "A dotted TextMate scope such as source.lua or text.html.basic."
    },
    "grammar": {
      "type": "object",
      "required": [
        "scopeName",
        "path",
        "license",
        "grammarSource"
      ],
      "properties": {
        "scopeName": {
          "$ref": "#/$defs/scopeName",
          "description": "The scope the grammar file declares. Another grammar includes this one by naming it."
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "string",
              "pattern": "\\.json$"
            }
          ],
          "description": "A TextMate grammar in its JSON form, under 4 MiB. Every pattern in it must compile with Oniguruma."
        },
        "languageId": {
          "type": "string",
          "pattern": "^[a-z0-9_+-]+$",
          "description": "The language this grammar colours, declared under contributes.languages of the same extension. A grammar that exists only to be included or injected has none."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The licence the grammar is distributed under, as an SPDX identifier where one exists."
        },
        "grammarSource": {
          "type": "string",
          "format": "uri",
          "description": "The https URL of the file this grammar was taken from."
        },
        "embeddedLanguages": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/scopeName"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9_+-]+$"
          },
          "description": "Scope name to language id, for the regions of another language this grammar embeds."
        },
        "injectTo": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/scopeName"
          },
          "description": "Scopes this grammar injects its rules into."
        }
      }
    },
    "configDirectory": {
      "description": "ConfigPath candidates: a $VAR candidate wins when the variable is set, a middle one only if it exists on disk, the last is the default. Only ~, ~/… and $VAR… forms; no absolute paths, no ..",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(~|\\$[A-Z_][A-Z0-9_]*)(/[^/]+)*$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(~|\\$[A-Z_][A-Z0-9_]*)(/[^/]+)*$"
          }
        }
      ]
    },
    "agentEvent": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "",
            "working",
            "awaiting",
            "done",
            "failed",
            "compacting",
            "denied",
            "ended",
            "notify"
          ]
        },
        "reply": {
          "type": "string"
        }
      }
    },
    "hookScript": {
      "type": "object",
      "properties": {
        "sessionKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stateFromPayload": {
          "type": "object",
          "required": [
            "key",
            "value",
            "state"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "state": {
              "enum": [
                "working",
                "awaiting",
                "done",
                "failed",
                "compacting",
                "denied",
                "ended",
                "notify"
              ]
            }
          }
        }
      }
    },
    "agentHooks": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "json"
            },
            "directory": {
              "$ref": "#/$defs/configDirectory"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "entryShape": {
              "enum": [
                "grouped",
                "flat"
              ]
            },
            "ownership": {
              "enum": [
                "shared",
                "owned"
              ]
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/agentEvent"
              }
            },
            "script": {
              "$ref": "#/$defs/hookScript"
            }
          },
          "required": [
            "kind",
            "directory",
            "fileName",
            "key",
            "events"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "toml"
            },
            "directory": {
              "$ref": "#/$defs/configDirectory"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/agentEvent"
              }
            },
            "script": {
              "$ref": "#/$defs/hookScript"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "directory",
            "fileName",
            "table",
            "events"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "file"
            },
            "directory": {
              "$ref": "#/$defs/configDirectory"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "template": {
              "$ref": "#/$defs/relativePath",
              "description": "A file inside the extension whose contents Phantom writes as the agent's plugin; {{agent}} and {{stateFileVariable}} are filled in."
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/agentEvent"
              }
            }
          },
          "required": [
            "kind",
            "directory",
            "fileName",
            "template"
          ]
        }
      ]
    },
    "agentMCP": {
      "type": "object",
      "required": [
        "kind",
        "directory",
        "fileName",
        "entry"
      ],
      "properties": {
        "kind": {
          "enum": [
            "json",
            "toml"
          ]
        },
        "directory": {
          "$ref": "#/$defs/configDirectory"
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "entry": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "enum": [
                "separateArguments",
                "singleArray"
              ]
            },
            "extras": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "boolean"
                ]
              },
              "propertyNames": {
                "not": {
                  "enum": [
                    "command",
                    "args"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "agentId",
        "name",
        "command"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^[a-z0-9_+-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "The binary Phantom launches in a new tab and looks for on PATH."
        },
        "resume": {
          "type": "object",
          "required": [
            "withSession"
          ],
          "properties": {
            "withSession": {
              "type": "string",
              "description": "Starts with command and contains {session}."
            },
            "withoutSession": {
              "type": "string"
            }
          }
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "icon": {
          "$ref": "#/$defs/relativePath"
        },
        "brandColour": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{6}|artwork)$"
        },
        "keepsOriginalColours": {
          "type": "boolean"
        },
        "hooks": {
          "$ref": "#/$defs/agentHooks"
        },
        "mcp": {
          "$ref": "#/$defs/agentMCP"
        }
      }
    }
  }
}
