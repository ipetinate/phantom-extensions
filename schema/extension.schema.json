{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ipetinate/phantom-extensions/schema/extension.schema.json",
  "title": "Phantom extension manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "contributes"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "phantom": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Lowest Phantom version that reads every key in this manifest."
    },
    "contributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "formatters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formatter"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theme"
          }
        },
        "iconThemes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/iconTheme"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
    },
    "installManager": {
      "enum": [
        "brew",
        "npm",
        "pnpm",
        "yarn",
        "cargo",
        "gem",
        "pipx",
        "go",
        "dotnet",
        "nix"
      ]
    },
    "installCommand": {
      "type": "object",
      "required": [
        "manager",
        "command"
      ],
      "properties": {
        "manager": {
          "$ref": "#/$defs/installManager"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Starts with the manager's own binary; no curl, pipes, sudo, ;, &&, &, $( ), backticks or redirects."
        },
        "uninstall": {
          "type": "string",
          "minLength": 1,
          "description": "Removes what command installed, under the same rules."
        }
      }
    },
    "install": {
      "type": "object",
      "description": "How Phantom installs the program this entry names. installHint stays the sentence shown when there is no install block.",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/installCommand"
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "The older form: one command whose first word is its package manager."
              }
            ]
          }
        },
        "documentationURL": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "language": {
      "type": "object",
      "required": [
        "languageId",
        "name",
        "extensions"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "pattern": "^[a-z0-9_+-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_+-]+$"
          },
          "minItems": 1
        },
        "fileNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "category": {
          "enum": [
            "script",
            "compiled",
            "markup",
            "frontendFramework",
            "styles",
            "data",
            "infrastructure"
          ]
        },
        "icon": {
          "$ref": "#/$defs/relativePath"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineComment": {
          "type": "string",
          "minLength": 1
        },
        "blockComment": {
          "type": "object",
          "required": [
            "open",
            "close"
          ],
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1
            },
            "close": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "syntax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "string": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "function": {
              "type": "string"
            },
            "attribute": {
              "type": "string"
            }
          }
        },
        "server": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "initializationOptions": {
              "type": "object"
            },
            "installHint": {
              "type": "string"
            },
            "documentationURL": {
              "type": "string",
              "format": "uri"
            },
            "install": {
              "$ref": "#/$defs/install"
            }
          }
        }
      }
    },
    "formatter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "command",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "$FILE stands for the path of the file being formatted."
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_+-]+$"
          },
          "minItems": 1
        },
        "installHint": {
          "type": "string"
        },
        "documentationURL": {
          "type": "string",
          "format": "uri"
        },
        "install": {
          "$ref": "#/$defs/install"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath",
          "description": "A Ghostty theme file."
        },
        "appearance": {
          "enum": [
            "dark",
            "light"
          ]
        }
      }
    },
    "iconTheme": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath",
          "description": "Directory holding a VS Code style *icon-theme.json and its SVGs."
        }
      }
    },
    "configDirectory": {
      "description": "ConfigPath candidates: a $VAR candidate wins when the variable is set, a middle one only if it exists on disk, the last is the default. Only ~, ~/… and $VAR… forms; no absolute paths, no ..",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(~|\\$[A-Z_][A-Z0-9_]*)(/[^/]+)*$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(~|\\$[A-Z_][A-Z0-9_]*)(/[^/]+)*$"
          }
        }
      ]
    },
    "agentEvent": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "",
            "working",
            "awaiting",
            "done",
            "failed",
            "compacting",
            "denied",
            "ended",
            "notify"
          ]
        },
        "reply": {
          "type": "string"
        }
      }
    },
    "hookScript": {
      "type": "object",
      "properties": {
        "sessionKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stateFromPayload": {
          "type": "object",
          "required": [
            "key",
            "value",
            "state"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "state": {
              "enum": [
                "working",
                "awaiting",
                "done",
                "failed",
                "compacting",
                "denied",
                "ended",
                "notify"
              ]
            }
          }
        }
      }
    },
    "agentHooks": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "json"
            },
            "directory": {
              "$ref": "#/$defs/configDirectory"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "entryShape": {
              "enum": [
                "grouped",
                "flat"
              ]
            },
            "ownership": {
              "enum": [
                "shared",
                "owned"
              ]
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/agentEvent"
              }
            },
            "script": {
              "$ref": "#/$defs/hookScript"
            }
          },
          "required": [
            "kind",
            "directory",
            "fileName",
            "key",
            "events"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "toml"
            },
            "directory": {
              "$ref": "#/$defs/configDirectory"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/agentEvent"
              }
            },
            "script": {
              "$ref": "#/$defs/hookScript"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "directory",
            "fileName",
            "table",
            "events"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "file"
            },
            "directory": {
              "$ref": "#/$defs/configDirectory"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "template": {
              "$ref": "#/$defs/relativePath",
              "description": "A file inside the extension whose contents Phantom writes as the agent's plugin; {{agent}} and {{stateFileVariable}} are filled in."
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/agentEvent"
              }
            }
          },
          "required": [
            "kind",
            "directory",
            "fileName",
            "template"
          ]
        }
      ]
    },
    "agentMCP": {
      "type": "object",
      "required": [
        "kind",
        "directory",
        "fileName",
        "entry"
      ],
      "properties": {
        "kind": {
          "enum": [
            "json",
            "toml"
          ]
        },
        "directory": {
          "$ref": "#/$defs/configDirectory"
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "entry": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "enum": [
                "separateArguments",
                "singleArray"
              ]
            },
            "extras": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "boolean"
                ]
              },
              "propertyNames": {
                "not": {
                  "enum": [
                    "command",
                    "args"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "agentId",
        "name",
        "command"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^[a-z0-9_+-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "The binary Phantom launches in a new tab and looks for on PATH."
        },
        "resume": {
          "type": "object",
          "required": [
            "withSession"
          ],
          "properties": {
            "withSession": {
              "type": "string",
              "description": "Starts with command and contains {session}."
            },
            "withoutSession": {
              "type": "string"
            }
          }
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "icon": {
          "$ref": "#/$defs/relativePath"
        },
        "brandColour": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{6}|artwork)$"
        },
        "keepsOriginalColours": {
          "type": "boolean"
        },
        "hooks": {
          "$ref": "#/$defs/agentHooks"
        },
        "mcp": {
          "$ref": "#/$defs/agentMCP"
        }
      }
    }
  }
}
